# Higher-privilege secret — only lives here, never in the app's root .env.
# Supabase dashboard -> Project Settings -> API -> "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: default OpenRouter model slug for tui_chat.py / analyze.py
# (overridable with --model). Check openrouter.ai/models for current :free slugs.
OPENROUTER_MODEL=

# SUPABASE_URL and OPENROUTER_DEBUG_API_KEY are read from the repo root .env —
# no need to duplicate them here.
